    {
      "id": 8,
      "type": "timeseries",
      "title": "Calls by outcome",
      "description": "ok, error (provider or network), refused (the AI declined), budget_blocked (no provider call made).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobradar-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobradar-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(\"createdAt\", '1h'), status::text AS metric, count(*)::float8 AS calls\nFROM ai_calls WHERE $__timeFilter(\"createdAt\") AND purpose IN ($purpose) AND model IN ($model) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 0,
            "showPoints": "never",
            "pointSize": 8,
            "fillOpacity": 100,
            "axisPlacement": "auto",
            "spanNulls": false,
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barWidthFactor": 0.8
          },
          "noValue": "no data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
