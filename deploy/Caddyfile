# Proxy of the app (SDD-012): static web build + /api to the API, plain HTTP on :80.
# TLS is terminated in front (Cloudflare, Coolify's Traefik), never here.
{
	auto_https off
	admin off
	servers {
		# Peers allowed to tell us the real client address. Default: any private address (Traefik on the Docker network).
		# From anyone else CF-Connecting-IP / X-Forwarded-For are ignored, so a client cannot choose its own IP.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Everything is same-origin: scripts, styles and fonts are bundled files. The only inline thing is the
		# style attribute React writes for animation delays (style-src-attr).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Liveness of this container (Docker / Coolify), independent of the API.
	handle /healthz {
		respond "ok" 200
	}

	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			# One trustworthy hop for the API (TRUST_PROXY=1): the client address Caddy worked out, nothing else.
			header_up X-Forwarded-For {client_ip}
			header_up -CF-Connecting-IP
			header_up -X-Real-IP
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		# Single-page app: any other path is a client-side route.
		try_files {path} /index.html
		file_server
	}
}
