    },
    {
      "id": 9,
      "type": "table",
      "title": "By purpose and model",
      "description": "Same filters as above. Cache columns are tokens served from / written to the provider cache.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobradar-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobradar-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT purpose, model,\n  count(*) AS calls,\n  count(*) FILTER (WHERE status = 'ok')::float8 / count(*) AS ok_rate,\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY \"latencyMs\") FILTER (WHERE status = 'ok') AS p50_ms,\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY \"latencyMs\") FILTER (WHERE status = 'ok') AS p95_ms,\n  sum(\"inputTokens\")::float8 AS input_tokens, sum(\"outputTokens\")::float8 AS output_tokens,\n  sum(\"cacheReadTokens\")::float8 AS cache_read, sum(\"cacheWriteTokens\")::float8 AS cache_write,\n  sum(\"costUsd\")::float8 AS cost_usd\nFROM ai_calls WHERE $__timeFilter(\"createdAt\") AND purpose IN ($purpose) AND model IN ($model) GROUP BY 1, 2 ORDER BY cost_usd DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "p50_ms|p95_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "input_tokens|output_tokens|cache_read|cache_write"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
