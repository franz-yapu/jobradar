generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RemoteScope {
  worldwide
  latam
  country
  onsite
  unknown
}

model Posting {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  company     String
  url         String         @unique
  source      String
  location    String?
  remoteScope RemoteScope
  description String
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  scores      PostingScore[]

  @@index([source])
  @@index([createdAt])
  @@map("postings")
}

enum Seniority {
  junior
  mid
  senior
  lead
}

enum EnglishLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum ContractType {
  temporary
  freelance
  internship
  part_time
}

/// Single-row table: the one candidate (v1). id is always "default".
model CandidateProfile {
  id                    String         @id
  stack                 String[]
  seniority             Seniority
  allowedLocations      String[]
  maxEnglishLevel       EnglishLevel
  excludedContractTypes ContractType[]
  summary               String
  /// Arrays of Education / Experience / LanguageSkill objects (validated by Zod in packages/shared).
  education             Json           @default("[]")
  experience            Json           @default("[]")
  languages             Json           @default("[]")
  certifications        String[]       @default([])
  version               Int
  updatedAt             DateTime       @updatedAt

  @@map("candidate_profiles")
}

enum AiCallStatus {
  ok
  error
  refused
  budget_blocked
}

/// One row per AI call attempt (including failures and budget blocks).
model AiCall {
  id               String         @id @default(uuid()) @db.Uuid
  purpose          String
  model            String
  status           AiCallStatus
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int
  cacheWriteTokens Int
  latencyMs        Int
  costUsd          Decimal        @db.Decimal(10, 6)
  detail           String?
  createdAt        DateTime       @default(now())
  scores           PostingScore[]

  @@index([createdAt])
  @@map("ai_calls")
}

enum Verdict {
  fit
  maybe
  reject
}

/// History of AI scores; each scoring call adds a row.
model PostingScore {
  id             String   @id @default(uuid()) @db.Uuid
  postingId      String   @db.Uuid
  posting        Posting  @relation(fields: [postingId], references: [id], onDelete: Cascade)
  verdict        Verdict
  reasons        String[]
  /// Array of { type, evidence }.
  blockers       Json
  profileVersion Int
  promptVersion  String
  model          String
  aiCallId       String?  @db.Uuid
  aiCall         AiCall?  @relation(fields: [aiCallId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([postingId, createdAt])
  @@map("posting_scores")
}
