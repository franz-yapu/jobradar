generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RemoteScope {
  worldwide
  latam
  country
  onsite
  unknown
}

model Posting {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  company     String
  url         String
  source      String
  location    String?
  remoteScope RemoteScope
  description String
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  scores      PostingScore[]
  /// Owner (ADR-0002). Null only for rows that predate accounts; the first account adopts them.
  userId      String?        @db.Uuid
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A posting is unique per account, not globally: two accounts may track the same URL.
  @@unique([userId, url])
  @@index([userId, createdAt])
  @@index([source])
  @@index([createdAt])
  @@map("postings")
}

enum Seniority {
  junior
  mid
  senior
  lead
}

enum EnglishLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum ContractType {
  temporary
  freelance
  internship
  part_time
}

/// Single-row table: the one candidate (v1). id is always "default".
model CandidateProfile {
  id                    String         @id
  stack                 String[]
  seniority             Seniority
  allowedLocations      String[]
  maxEnglishLevel       EnglishLevel
  excludedContractTypes ContractType[]
  summary               String
  /// Arrays of Education / Experience / LanguageSkill objects (validated by Zod in packages/shared).
  education             Json           @default("[]")
  experience            Json           @default("[]")
  languages             Json           @default("[]")
  certifications        String[]       @default([])
  version               Int
  updatedAt             DateTime       @updatedAt
  /// Owner (one profile per account). Null only for the legacy row, adopted by the first account.
  userId                String?        @unique @db.Uuid
  user                  User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

enum AiCallStatus {
  ok
  error
  refused
  budget_blocked
}

/// One row per AI call attempt (including failures and budget blocks).
model AiCall {
  id               String         @id @default(uuid()) @db.Uuid
  purpose          String
  model            String
  status           AiCallStatus
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int
  cacheWriteTokens Int
  latencyMs        Int
  costUsd          Decimal        @db.Decimal(10, 6)
  detail           String?
  createdAt        DateTime       @default(now())
  scores           PostingScore[]
  /// Who spent it: the budget is per account. Null only for rows that predate accounts.
  userId           String?        @db.Uuid
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_calls")
}

enum Verdict {
  fit
  maybe
  reject
}

/// History of AI scores; each scoring call adds a row.
model PostingScore {
  id             String   @id @default(uuid()) @db.Uuid
  postingId      String   @db.Uuid
  posting        Posting  @relation(fields: [postingId], references: [id], onDelete: Cascade)
  verdict        Verdict
  reasons        String[]
  /// Array of { type, evidence }.
  blockers       Json
  profileVersion Int
  promptVersion  String
  model          String
  aiCallId       String?  @db.Uuid
  aiCall         AiCall?  @relation(fields: [aiCallId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  /// Owner, same as the posting's. Null only for rows that predate accounts.
  userId         String?  @db.Uuid
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postingId, createdAt])
  @@index([userId])
  @@map("posting_scores")
}

/// A person with an account (ADR-0002). Email is stored lowercase.
model User {
  id            String            @id @default(uuid()) @db.Uuid
  email         String            @unique
  passwordHash  String
  createdAt     DateTime          @default(now())
  sessions      Session[]
  postings      Posting[]
  profile       CandidateProfile?
  postingScores PostingScore[]
  aiCalls       AiCall[]

  @@map("users")
}

/// A browser session. Only the SHA-256 of the cookie token is stored.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
