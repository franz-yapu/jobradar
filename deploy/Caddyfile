# Proxy of the app and the n8n gate (SDD-012): static web build + /api to the API for the app host, and a password
# gate in front of n8n for the n8n host. Plain HTTP on :80: TLS is terminated in front (Coolify's Traefik).
# Both public hosts are mapped to this one service in Coolify; the Host header decides.
{
	auto_https off
	admin off
	servers {
		# Peers allowed to tell us the real client address. Default: any private address (Traefik on the Docker network).
		# From anyone else the headers below are ignored, so a client cannot choose its own IP.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		# Read X-Forwarded-For from the right and stop at the first address that is not a trusted proxy. By default Caddy
		# takes the leftmost entry, which is the one a client can prepend itself.
		trusted_proxies_strict
		# Which header carries the client address, first match wins. Behind Coolify's Traefik alone (sites that are not
		# proxied by Cloudflare) only X-Forwarded-For is trustworthy: Traefik overwrites what the client sent. Add
		# CF-Connecting-IP in front of it ONLY if every request really arrives through Cloudflare's proxy.
		client_ip_headers {$CLIENT_IP_HEADERS:X-Forwarded-For}
	}
}

# n8n: nothing reaches the editor without the shared password (the generated hash is in N8N_BASIC_AUTH_HASH, see
# web-entrypoint.sh). n8n has its own login behind this; the gate stops the world from even seeing it.
http://{$N8N_HOST:jobradar-n8n.vertexall.com} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		basic_auth bcrypt "JobRadar n8n" {
			{$N8N_BASIC_AUTH_USER:admin} {$N8N_BASIC_AUTH_HASH}
		}
		reverse_proxy {$N8N_UPSTREAM:n8n:5678} {
			header_up X-Forwarded-For {client_ip}
			header_up -CF-Connecting-IP
			header_up -X-Real-IP
		}
	}
}

:80 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Everything is same-origin: scripts, styles and fonts are bundled files. The only inline thing is the
		# style attribute React writes for animation delays (style-src-attr).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Liveness of this container (Docker / Coolify), independent of the API.
	handle /healthz {
		respond "ok" 200
	}

	handle_path /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			# One trustworthy hop for the API (TRUST_PROXY=1): the client address Caddy worked out, nothing else.
			header_up X-Forwarded-For {client_ip}
			header_up -CF-Connecting-IP
			header_up -X-Real-IP
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		# Single-page app: any other path is a client-side route.
		try_files {path} /index.html
		file_server
	}
}
