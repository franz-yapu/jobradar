DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar
# Optional: integration tests use this database; falls back to DATABASE_URL
TEST_DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar_test
ANTHROPIC_API_KEY=
# AI provider: anthropic (default, production) or groq (cheap trials)
AI_PROVIDER=anthropic
GROQ_API_KEY=
# Model used for scoring; must have a price in apps/api/src/ai/infrastructure/pricing.ts.
# Leave empty for the provider default (claude-sonnet-5-5 / openai/gpt-oss-20b).
AI_MODEL=
AI_DAILY_BUDGET_USD=1
PORT=3000
# Host ports for docker compose (change if they clash with other local services)
POSTGRES_PORT=5432
N8N_PORT=5678
GRAFANA_PORT=3001
# Address of the API as seen from the n8n container (the host API on PORT)
JOBRADAR_API_URL=http://host.docker.internal:3000
# Telegram chat that receives the daily summary (see n8n/workflows/README.md)
TELEGRAM_CHAT_ID=
