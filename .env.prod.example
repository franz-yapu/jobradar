# Production environment (SDD-012). In Coolify paste these in the resource's Environment Variables; never commit real values.
# Generate secrets with:  openssl rand -hex 32   (hex avoids characters that break the database URL)

# --- Required
POSTGRES_PASSWORD=
WEB_ORIGIN=https://jobradar.vertexall.com
ADMIN_EMAILS=
N8N_ENCRYPTION_KEY=
# Password in front of the n8n host (user + password asked by the browser before n8n's own login). Long and random.
N8N_BASIC_AUTH_PASSWORD=

# --- Database (defaults are fine)
# POSTGRES_USER=jobradar
# POSTGRES_DB=jobradar

# --- Sign-in with Google. Redirect URI must be registered in Google Cloud Console, exactly:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://jobradar.vertexall.com/api/auth/google/callback

# --- AI (Groq for the demo). Per-account cap and the cap for ALL accounts together (open registration).
AI_PROVIDER=groq
GROQ_API_KEY=
AI_DAILY_BUDGET_USD=0.5
AI_GLOBAL_DAILY_BUDGET_USD=2
# ALLOW_SIGNUP=true   # set false to close registration

# --- Batch scoring through AWS (SDD-010): outputs of `terraform apply` and an IAM user holding the api-sender policy.
# Leave SQS_QUEUE_URL empty to score inside the API process instead.
SQS_QUEUE_URL=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
WORKER_SECRET=

# --- n8n (the token is created in the app by the administrator, after the first deploy)
N8N_HOST=jobradar-n8n.vertexall.com
# N8N_BASIC_AUTH_USER=admin
JOBRADAR_API_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backups (UTC hour of the daily dump, dumps kept)
# BACKUP_HOUR_UTC=3
# BACKUP_KEEP=14

# --- Client address. Default is right behind Coolify's Traefik with sites that Cloudflare does not proxy.
# Only if the app host is proxied by Cloudflare (orange cloud) AND the VPS accepts web traffic from Cloudflare alone:
# CLIENT_IP_HEADERS=CF-Connecting-IP X-Forwarded-For
