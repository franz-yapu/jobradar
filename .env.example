DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar
# Optional: integration tests use this database; falls back to DATABASE_URL
TEST_DATABASE_URL=postgresql://jobradar:jobradar@localhost:5432/jobradar_test
ANTHROPIC_API_KEY=
# AI provider: anthropic (default, production) or groq (cheap trials)
AI_PROVIDER=anthropic
GROQ_API_KEY=
# Model used for scoring; must have a price in apps/api/src/ai/infrastructure/pricing.ts.
# Leave empty for the provider default (claude-sonnet-5-5 / openai/gpt-oss-20b).
AI_MODEL=
AI_DAILY_BUDGET_USD=1
PORT=3000
# Browser origins allowed to call the API (comma separated); the dashboard dev server by default
WEB_ORIGIN=http://localhost:5173
# Open registration; set to false once the intended accounts exist
ALLOW_SIGNUP=true
# Host ports for docker compose (change if they clash with other local services)
POSTGRES_PORT=5432
N8N_PORT=5678
GRAFANA_PORT=3001
# Address of the API as seen from the n8n container (the host API on PORT)
JOBRADAR_API_URL=http://host.docker.internal:3000
# API token the n8n workflows use (an account creates it: POST /auth/tokens). Never commit a real one.
JOBRADAR_API_TOKEN=
# Telegram chat that receives the daily summary (see n8n/workflows/README.md)
TELEGRAM_CHAT_ID=

# Administrators who feed the shared job catalog (comma separated). Their email must be verified, i.e. they sign in with Google.
ADMIN_EMAILS=

# Sign in with Google (optional). Create an OAuth client in Google Cloud Console (see README); all three or none.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Batch scoring queue (SDD-010). Empty = jobs run inside the API process. With a queue URL, jobs go through SQS and the
# worker Lambda calls the API back; WORKER_SECRET (32+ random chars, e.g. `openssl rand -hex 32`) is then required.
SQS_QUEUE_URL=
AWS_REGION=us-east-1
# Only for LocalStack (docker compose --profile aws up -d localstack)
AWS_ENDPOINT_URL=
WORKER_SECRET=
