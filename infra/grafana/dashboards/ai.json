{
  "uid": "jobradar-ai",
  "title": "JobRadar – AI latency, tokens and cost",
  "tags": [
    "jobradar",
    "ai"
  ],
  "description": "Read from ai_calls through the read-only grafana_reader role (SDD-010).",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "purpose",
        "label": "Purpose",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "jobradar-pg"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "query": "SELECT DISTINCT purpose FROM ai_calls ORDER BY 1",
        "definition": "SELECT DISTINCT purpose FROM ai_calls ORDER BY 1"
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "jobradar-pg"
        },
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "query": "SELECT DISTINCT model FROM ai_calls ORDER BY 1",
        "definition": "SELECT DISTINCT model FROM ai_calls ORDER BY 1"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "AI calls",
      "description": "Every attempt in the range, including failures and budget blocks.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobradar-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobradar-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS calls FROM ai_calls WHERE $__timeFilter(\"createdAt\") AND purpose IN ($purpose) AND model IN ($model)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cost",
      "description": "Estimated spend from pricing.ts (USD).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobradar-pg"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobradar-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(sum(\"costUsd\"), 0)::float8 AS cost FROM ai_calls WHERE $__timeFilter(\"createdAt\") AND purpose IN ($purpose) AND model IN ($model)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate",
      "description": "Provider or network failures divided by all calls. Refusals and budget blocks are not errors.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobradar-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobradar-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(count(*) FILTER (WHERE status = 'error')::float8 / NULLIF(count(*), 0), 0) AS error_rate FROM ai_calls WHERE $__timeFilter(\"createdAt\") AND purpose IN ($purpose) AND model IN ($model)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 0.05
              },
              {
                "color": "#d03b3b",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency",
      "description": "95th percentile of successful calls.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobradar-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobradar-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY \"latencyMs\") AS p95 FROM ai_calls WHERE $__timeFilter(\"createdAt\") AND purpose IN ($purpose) AND model IN ($model) AND status = 'ok'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency, successful calls",
      "description": "Median and 95th percentile per hour. One axis, milliseconds.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobradar-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobradar-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(\"createdAt\", '1h'),\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY \"latencyMs\") AS p50,\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY \"latencyMs\") AS p95\nFROM ai_calls WHERE $__timeFilter(\"createdAt\") AND purpose IN ($purpose) AND model IN ($model) AND status = 'ok' GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "showPoints": "auto",
            "pointSize": 8,
            "fillOpacity": 0,
            "axisPlacement": "auto",
            "spanNulls": false,
            "drawStyle": "line",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "noValue": "no data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens",
      "description": "Input and output tokens per hour (cache tokens are in the table below).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobradar-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobradar-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(\"createdAt\", '1h'),\n  sum(\"inputTokens\")::float8 AS input, sum(\"outputTokens\")::float8 AS output\nFROM ai_calls WHERE $__timeFilter(\"createdAt\") AND purpose IN ($purpose) AND model IN ($model) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 0,
            "showPoints": "never",
            "pointSize": 8,
            "fillOpacity": 100,
            "axisPlacement": "auto",
            "spanNulls": false,
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barWidthFactor": 0.8
          },
          "noValue": "no data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "input"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "output"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cost by model",
      "description": "Estimated USD per hour, one colour per model (the colour follows the model, not its rank).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jobradar-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jobradar-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(\"createdAt\", '1h'), model AS metric, sum(\"costUsd\")::float8 AS cost\nFROM ai_calls WHERE $__timeFilter(\"createdAt\") AND purpose IN ($purpose) AND model IN ($model) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 0,
            "showPoints": "never",
            "pointSize": 8,
            "fillOpacity": 100,
            "axisPlacement": "auto",
            "spanNulls": false,
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
